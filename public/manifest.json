{
  "manifest_version": 3,
  "name": "Lectio Study Reader",
  "version": "0.1.0",
  "description": "Open technical articles in a focused study reader with local highlights and notes.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Open in Study Reader"
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["assets/content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
